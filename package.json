{
  "name": "aeroflow-fpv",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "dev": "npm run build:wasm && vite --host 127.0.0.1",
    "build": "npm run build:wasm && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run build:wasm && cargo test --locked --manifest-path rust/flight-core/Cargo.toml && node --experimental-strip-types --test tests/*.test.ts",
    "check:generated": "node scripts/generate-alpine-data.mjs --check",
    "check": "npm run check:generated && npm test && tsc -b && tsc -p tsconfig.e2e.json",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.183.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.183.0",
    "@vitejs/plugin-react": "^5.1.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
